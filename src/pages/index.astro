---
import { Image } from "astro:assets";
import panis from "../assets/panis.jpg";
import Coffee from "../components/Coffee.astro";
import HeroFrames from "../components/HeroFrames.astro";
import Base from "../layouts/Base.astro";

const youBring = [
  "事業への理解",
  "お客様への理解",
  "現場で積み重ねた経験",
  "これから実現したいこと",
];
const weBring = [
  "Design",
  "Technology",
  "Web / AIへの知識",
  "つくり、改善し続ける力",
];
const capabilities = [
  ["Web Design", "伝えたいことが、伝わる設計。"],
  ["Frontend Development", "使う人に自然な、確かな実装。"],
  ["CMS / Content Systems", "日々の発信を、自分たちの手で。"],
  ["SEO / AI Search", "見つけてもらうための、土台づくり。"],
  ["Maintenance / Improvement", "公開してからも、一緒に育てる。"],
];
const steps = [
  [
    "Listen",
    "まず、聴く。",
    "事業のこと、現場のこと。",
    "まだ言葉にならない違和感も。",
  ],
  [
    "Align",
    "目線を、そろえる。",
    "何を解くのか、どこへ向かうのか。",
    "共通の目的を見つけます。",
  ],
  [
    "Make",
    "一緒に、つくる。",
    "試し、確かめ、対話する。",
    "小さな判断を重ねてかたちに。",
  ],
  [
    "Grow",
    "その先も、育てる。",
    "公開は、次のはじまり。",
    "使われ方を見ながら改善します。",
  ],
];
const principles = [
  "対話を大切にする。",
  "技術的な品質に、妥協しない。",
  "ひとつひとつの仕事に、誠実に。",
];
---

<Base>
        <section class="hero">
          <div class="hero-main">
            <div class="hero-copy">
              <p class="label">SAME TABLE. SHARED PROBLEM.</p>
              <h1>同じテーブルで、<br />考える。</h1>
              <p class="intro">
                Panisiaは、依頼する側とつくる側を分けません。<br />あなたの知識と、私たちの技術を同じテーブルに<br />持ち寄り、ひとつの課題を一緒に考えます。
              </p>
            </div>
            <HeroFrames />
          </div>
          <div class="hero-baseline">
            <p class="label">Panisia / DESIGN &amp; TECHNOLOGY</p>
            <a class="label" href="#approach">EXPLORE OUR APPROACH ↓</a>
          </div>
        </section>

          <section id="approach" class="section table-section">
            <p class="label">01 / THE TABLE</p>
            <div>
              <div class="tabletop split">
                <div class="stack">
                  <h2 class="contribution-heading">あなたが<br />持ってくるもの</h2>
                  <ul class="contribution-list">
                    {youBring.map((item) => <li>{item}</li>)}
                  </ul>
                </div>
                <div class="stack">
                  <h2 class="contribution-heading">Panisiaが<br />持ってくるもの</h2>
                  <ul class="contribution-list">
                    {weBring.map((item) => <li>{item}</li>)}
                  </ul>
                </div>
              </div>
              <div class="seats" aria-hidden="true">
                {
                  [0, 1].map(() => (
                    <div>
                      <svg class="chair" viewBox="0 0 220 220">
                        <rect x="55.825" y="68.148" width="108.35" height="109.345" />
                        <path d="M55.825 47.663V34.32h108.35v13.343" />
                      </svg>
                    </div>
                  ))
                }
              </div>
            </div>
            <div class="common-problem">
              <p class="same-side">違う知識を、<br />同じ課題のために。</p>
              <p class="label">YOU + Panisia → A SHARED PROBLEM</p>
            </div>
          </section>

          <section class="section tint manifesto">
            <p class="label">02 / OUR MANIFESTO</p>
            <h2 class="statement">良いものは、<br />片側だけではつくれない。</h2>
            <div class="split bottom">
              <p class="echo">Not across from you.<br />Alongside you.</p>
              <p class="body-lg">
                私たちは、答えを持って訪れる専門家ではなく、<br />同じ側から課題を見る技術者でありたいと考えています。<br />Web制作は、目的ではなく、そのための手段です。
              </p>
            </div>
          </section>

          <section class="section">
            <div class="split center">
              <Image
                class="photo"
                src={panis}
                alt="リネンの上で二つに割られた丸いパン"
                widths={[480, 720, 1200]}
                sizes="(max-width: 800px) 100vw, 600px"
                format="webp"
              />
              <div class="stack">
                <p class="label">03 / OUR NAME</p>
                <h2 class="panis">Panis.</h2>
                <p class="origin-heading">分かち合うことから、はじまる。</p>
                <p class="body">
                  Panisは、ラテン語で「パン」。<br />パンを分け合うように、知識や経験、技術を<br />同じ場所に持ち寄る。<br />Panisiaという名前には、<br />そんな仕事のあり方を込めています。
                </p>
              </div>
            </div>
          </section>

          <section id="services" class="section services">
            <div class="split">
              <div class="stack tight">
                <p class="label">04 / WHAT WE MAKE TOGETHER</p>
                <h2 class="heading-lg">一緒に考え、<br />かたちにする。</h2>
              </div>
              <p class="body-lg">
                課題に合わせて、必要なものを。<br />設計から開発、公開後の改善まで、<br />ひとつながりのものづくりを支えます。
              </p>
            </div>
            <ol class="capabilities">
              {
                capabilities.map(([name, description], i) => (
                  <li>
                    <span class="label">{String(i + 1).padStart(2, "0")}</span>
                    <span class="capability">{name}</span>
                    <span class="capability-description">{description}</span>
                  </li>
                ))
              }
            </ol>
          </section>

          <section class="section tint">
            <p class="label">05 / SELECTED WORK</p>
            <div class="split">
              <h2 class="work-heading">一緒につくったもの。<br />その背景にあること。</h2>
              <div class="stack tight">
                <p class="status">事例は、ただいま掲載準備中です。</p>
                <p class="body-sm">
                  完成したものだけでなく、出発点となった課題、<br />お互いが持ち寄った知識、そこから得た学びまで。<br />私たちの仕事の過程をお伝えしていきます。
                </p>
              </div>
            </div>
          </section>

          <section class="section">
            <p class="label">06 / HOW WE WORK</p>
            <div class="process-heading">
              <h2 class="heading-md">同じ側で、進めていく。</h2>
              <Coffee />
            </div>
            <ol class="process">
              {
                steps.map(([verb, title, line1, line2], i) => (
                  <li>
                    <span class="label">{String(i + 1).padStart(2, "0")}</span>
                    <span class="verb">{verb}</span>
                    <span class="process-title">{title}</span>
                    <span class="body-sm">
                      {line1}
                      <br />
                      {line2}
                    </span>
                  </li>
                ))
              }
            </ol>
          </section>

          <section id="about" class="section about">
            <hr />
            <div class="split">
              <div class="stack">
                <p class="label">07 / ABOUT Panisia</p>
                <h2 class="heading-md">人に近く。<br />技術には、誠実に。</h2>
              </div>
              <div class="stack">
                <p class="about-description">
                  事業をいちばんよく知る人と、<br />技術で可能性を広げる人。<br />その両方が揃って、できることがある。
                </p>
                <ul class="principles">
                  {
                    principles.map((text) => (
                      <li>
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                          <circle cx="10.9" cy="11.6" r="5.3" />
                          <path d="M16.14 10.26h.82a1.39 1.38 0 0 1 0 2.76h-.82" />
                        </svg>
                        {text}
                      </li>
                    ))
                  }
                </ul>
              </div>
            </div>
          </section>

          <section id="contact" class="section tint contact">
            <p class="label">08 / AN INVITATION</p>
            <h2 class="contact-heading">同じテーブルで、<br />話しましょう。</h2>
            <div class="invitation">
              <p class="body-lg">
                まだ、まとまっていなくても大丈夫です。<br />いま考えていることから、聞かせてください。
              </p>
              <div class="contact-actions">
                <a class="talk" href="/contact/">
                  話してみる
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M7 17 17 7M7 7h10v10" />
                  </svg>
                </a>
                <p class="contact-email">info@panisia.com</p>
              </div>
            </div>
          </section>

    <script>
      // 天板の下端が画面下88%に来てから、画面高35%のスクロールで椅子を天板の下から引き出す
      const tabletop = document.querySelector<HTMLElement>(".tabletop");
      const chair = document.querySelector<SVGSVGElement>(".chair");
      const root = document.documentElement;
      const reduced = matchMedia("(prefers-reduced-motion: reduce)");
      let frame = 0;

      function update() {
        frame = 0;
        if (!tabletop || !chair || reduced.matches) {
          root.style.removeProperty("--seat-offset");
          return;
        }
        // 動く椅子ではなく静止した天板の縁を読むので、引き出し自体が進捗に影響しない
        const edge = tabletop.getBoundingClientRect().bottom;
        const trigger = Math.min(innerHeight * 0.88, edge + scrollY);
        const progress = Math.max(
          0,
          Math.min(1, (trigger - edge) / (innerHeight * 0.35)),
        );
        const eased = progress * progress * (3 - 2 * progress);
        // 初期位置は座面の約半分が天板に隠れる位置（椅子の高さ 220px に対し 97px 上）
        const tucked = (chair.getBoundingClientRect().height * 97) / 220;
        root.style.setProperty("--seat-offset", `${-tucked * (1 - eased)}px`);
      }
      function schedule() {
        if (!frame && !document.hidden) frame = requestAnimationFrame(update);
      }

      addEventListener("scroll", schedule, { passive: true });
      addEventListener("resize", schedule, { passive: true });
      reduced.addEventListener("change", schedule);
      document.addEventListener("visibilitychange", schedule);
      update();

    </script>
</Base>
