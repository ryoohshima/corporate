---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Panisia",
  description = "Panisiaは、依頼する側とつくる側を分けません。あなたの知識と、私たちの技術を同じテーブルに持ち寄り、ひとつの課題を一緒に考えます。",
} = Astro.props;

const nav = [
  { href: "/#approach", label: "Our approach" },
  { href: "/#services", label: "What we do" },
  { href: "/#about", label: "About" },
];
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta
      name="description"
      content={description}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif&family=Inter:wght@400&family=Noto+Serif+JP:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="page">
      <header class="site-header">
        <a class="wordmark" href="/">Panisia</a>
        <nav class="nav" aria-label="メイン">
          {nav.map((item) => <a href={item.href}>{item.label}</a>)}
          <a class="accent" href="/#contact">話してみる ↗</a>
        </nav>
        <details class="menu">
          <summary aria-label="メニュー">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
          </summary>
          <nav aria-label="メイン（モバイル）">
            {nav.map((item) => <a href={item.href}>{item.label}</a>)}
            <a class="accent" href="/#contact">話してみる ↗</a>
          </nav>
        </details>
      </header>


      <main>
        <slot />
      </main>


      <footer class="site-footer">
        <hr />
        <div class="footer-identity">
          <p class="footer-wordmark">Panisia</p>
          <p class="footer-promise">Same table. Shared problem.</p>
        </div>
        <div class="footer-legal">
          <small>© Panisia</small>
          <a href="/privacy/">Privacy policy</a>
        </div>
      </footer>
    </div>

    <script>
      // モバイルメニュー: リンク選択・Esc で閉じる
      const menu = document.querySelector<HTMLDetailsElement>(".menu");
      menu?.addEventListener("click", (event) => {
        if ((event.target as Element).closest("a")) menu.open = false;
      });
      document.addEventListener("keydown", (event) => {
        if (menu?.open && event.key === "Escape") {
          menu.open = false;
          menu.querySelector("summary")?.focus();
        }
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f3efe6;
    --bg-tint: #faf8f3;
    --ink: #211f1b;
    --muted: #6f6a61;
    --line: #cec7bb;
    --accent: #a95538;
    --serif: "Noto Serif JP", serif;
    --latin: "Instrument Serif", serif;
    --ui: Inter, system-ui, sans-serif;
  }
  *,
  ::before,
  ::after {
    box-sizing: border-box;
  }
  html {
    scroll-behavior: smooth;
  }
  /* ページ遷移: ヘッダーは固定し、本文をクロスフェード（非対応ブラウザは通常遷移） */
  @view-transition {
    navigation: auto;
  }
  .site-header {
    view-transition-name: site-header;
  }
  ::view-transition-group(root) {
    animation-duration: 0.4s;
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    @view-transition {
      navigation: none;
    }
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: var(--serif);
  }
  h1,
  h2,
  p,
  ul,
  ol {
    margin: 0;
    padding: 0;
    font-weight: 400;
  }
  ul,
  ol {
    list-style: none;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  hr {
    width: 100%;
    margin: 0;
    border: 0;
    border-top: 1px solid var(--line);
  }
  svg path,
  svg rect,
  svg circle {
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .page {
    max-width: 1440px;
    margin-inline: auto;
    padding: 0 32px;
  }
  .label {
    color: var(--muted);
    font: 12px var(--ui);
    letter-spacing: 1.6px;
  }

  /* Header */
  .site-header {
    position: relative;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 28px 48px;
  }
  .wordmark {
    position: relative;
    z-index: 3;
    font: 25px var(--latin);
    letter-spacing: 4px;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 36px;
    font: 13px var(--ui);
  }
  .accent {
    color: var(--accent);
    font: 14px var(--serif);
  }
  .menu {
    display: none;
    position: relative;
  }
  .menu summary {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    list-style: none;
    cursor: pointer;
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  /* ヘッダー内の重なり順: 背景(1) < パネル(2) < ロゴ・アイコン(3) */
  .menu summary svg {
    position: relative;
    z-index: 3;
    width: 24px;
    height: 24px;
  }
  /* 開いている間は summary の疑似要素を全画面の背景にし、タップで閉じられるようにする */
  .menu[open] summary::before {
    content: "";
    position: fixed;
    inset: 0;
    z-index: 1;
    background: rgb(33 31 27 / 0.45);
    cursor: default;
  }

  .menu nav {
    position: fixed;
    top: 0;
    inset-inline: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    padding: 92px 24px 24px;
    background: var(--bg-tint);
    border-bottom: 1px solid var(--line);
    font: 18px var(--ui);
  }
  .menu nav a {
    padding: 16px 0;
    border-top: 1px solid var(--line);
  }

  /* Hero */
  .hero {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 36px;
    padding: 80px 48px 24px;
    background: var(--bg);
  }
  h1 {
    font: 500 67px/90px var(--serif);
    letter-spacing: -2px;
  }
  .intro {
    font-size: 17px;
    line-height: 32px;
  }
  .hero-main {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    align-items: center;
    gap: 48px;
  }
  .hero-copy { display: flex; flex-direction: column; gap: 36px; min-width: 0; }
  @media (min-width: 801px) and (max-width: 1100px) {
    .hero-main { gap: 24px; }
    .hero h1 { font-size: 48px; line-height: 1.45; }
    .hero .intro br { display: none; }
  }
  .hero-baseline {
    display: flex;
    justify-content: space-between;
    padding: 8px 0;
    margin-top: -12px;
  }

  .section {
    display: flex;
    flex-direction: column;
    gap: 48px;
    padding: 100px 48px;
    background: var(--bg);
    scroll-margin-top: 24px;
  }
  /* 背景だけを画面端まで広げ、本文は共通の縦ラインに揃える */
  .tint {
    background: var(--bg-tint);
    box-shadow: 0 0 0 100vmax var(--bg-tint);
    clip-path: inset(0 -100vmax);
  }
  .split {
    display: flex;
    gap: 80px;
  }
  .split > * {
    flex: 1 1 0;
    min-width: 0;
  }
  .split.center {
    align-items: center;
  }
  .split.bottom {
    align-items: flex-end;
  }
  .stack {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .stack.tight {
    gap: 24px;
  }
  .body {
    font-size: 17px;
    line-height: 32px;
  }
  .body-lg {
    font-size: 18px;
    line-height: 34px;
  }
  .body-sm {
    font-size: 16px;
    line-height: 30px;
  }
  .heading-lg {
    font: 48px/67px var(--serif);
  }
  .heading-md {
    font: 46px/64px var(--serif);
  }

  /* Table: 天板の上に持ち寄ったものを並べ、奥に引き出した椅子を置く */
  .table-section {
    gap: 40px;
    padding: 72px 48px 96px;
  }
  /* 椅子が天板の下へ潜り込むよう、天板を上に重ねる */
  .tabletop {
    position: relative;
    z-index: 1;
    background: var(--bg);
    padding: 64px 72px;
    outline: 1px solid var(--line);
    outline-offset: -0.5px;
  }
  .seats {
    display: flex;
    gap: 80px;
    padding: 0 72px;
  }
  .seats > div {
    flex: 1 1 0;
    display: flex;
    justify-content: center;
  }
  .chair {
    width: 220px;
    height: 220px;
    transform: translateY(var(--seat-offset, 0px)) scaleY(-1);
  }
  .chair rect,
  .chair path {
    stroke: var(--line);
    stroke-width: 1;
    fill: none;
  }
  .contribution-heading {
    font: 27px var(--serif);
  }
  .contribution-heading br,
  .same-side br {
    display: none;
  }
  .contribution-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
    font-size: 18px;
    line-height: 29px;
  }
  .common-problem {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }
  .same-side {
    font: 30px var(--serif);
    text-align: center;
  }

  .manifesto {
    padding-block: 112px;
  }
  .statement {
    font: 500 58px/81px var(--serif);
  }
  .echo {
    color: var(--muted);
    font: 38px/44px var(--latin);
  }

  .photo {
    display: block;
    width: 100%;
    height: 440px;
    object-fit: cover;
  }
  .panis {
    font: 84px/88px var(--latin);
  }
  .origin-heading {
    font: 28px var(--serif);
  }

  .services {
    padding-top: 60px;
  }
  .capabilities {
    border-top: 1px solid var(--line);
  }
  .capabilities li {
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 26px 0;
    border-bottom: 1px solid var(--line);
  }
  .capability {
    flex: 1 1 0;
    font: 31px var(--latin);
  }
  .capability-description {
    flex: 0 1 480px;
    font-size: 16px;
  }

  .work-heading {
    font: 43px/62px var(--serif);
  }
  .status {
    font: 20px var(--serif);
  }

  .process-heading {
    display: flex;
    align-items: center;
    gap: 40px;
  }
  .process-heading h2 {
    flex: 1 1 0;
    line-height: normal;
  }
  .process {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    padding: 24px 0;
    border-block: 1px solid var(--line);
  }
  .process li {
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding: 8px 24px;
  }
  .process li + li {
    border-left: 1px solid var(--line);
  }
  .verb {
    font: 43px var(--latin);
  }
  .process-title {
    font: 20px var(--serif);
  }

  .about {
    padding: 80px 48px 120px;
  }
  .about-description {
    font: 23px/41px var(--serif);
  }
  .principles {
    display: flex;
    flex-direction: column;
    gap: 18px;
    font-size: 16px;
    line-height: 28px;
  }
  .principles li {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .principles svg {
    flex-shrink: 0;
    color: var(--line);
    width: 24px;
    height: 24px;
  }

  .contact {
    gap: 38px;
    padding-bottom: 96px;
  }
  .contact-heading {
    font: 65px/91px var(--serif);
  }
  .invitation {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
  }
  .talk {
    display: flex;
    align-items: center;
    gap: 60px;
    flex-shrink: 0;
    padding: 18px 0;
    border-bottom: 1px solid var(--accent);
    color: var(--accent);
    font: 25px var(--serif);
  }
  .talk svg {
    width: 28px;
    height: 28px;
  }
  .contact-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 14px;
  }
  .contact-email {
    color: var(--muted);
    font: 14px var(--ui);
  }

  /* Footer */
  .site-footer {
    display: flex;
    flex-direction: column;
    gap: 36px;
    padding: 40px 48px;
  }
  .footer-identity,
  .footer-legal {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .footer-wordmark {
    font: 40px var(--latin);
    letter-spacing: 5px;
  }
  .footer-promise {
    color: var(--muted);
    font: 19px var(--latin);
  }
  .footer-legal {
    color: var(--muted);
    font: 12px var(--ui);
  }
  .footer-legal small {
    font-size: inherit;
  }

  @media (max-width: 800px) {
    .page {
      padding: 0 12px;
    }
    br {
      display: none;
    }
    .site-header {
      padding: 24px 12px;
    }
    .wordmark {
      font-size: 24px;
    }
    .nav {
      display: none;
    }
    .menu {
      display: block;
    }
    .hero {
      gap: 32px;
      padding: 40px 12px 24px;
    }
    h1 {
      font-size: 38px;
      line-height: 51px;
      letter-spacing: -1px;
    }
    h1 br {
      display: inline;
    }
    .intro {
      font-size: 16px;
      line-height: 30px;
    }
    .hero-main { grid-template-columns: 1fr; gap: 24px; }
    .hero-copy { gap: 32px; }
    .hero-baseline {
      flex-direction: column;
      gap: 14px;
      margin-top: 0;
    }
    .section,
    .manifesto,
    .about,
    .contact {
      gap: 32px;
      padding: 72px 12px;
    }
    .split,
    .invitation,
    .footer-identity {
      flex-direction: column;
      align-items: flex-start;
      gap: 32px;
    }
    .split > * {
      flex: none;
      width: 100%;
    }
    .contact-actions {
      align-items: flex-start;
    }
    .table-section {
      gap: 28px;
      padding: 48px 12px 64px;
    }
    .tabletop {
      flex-direction: row;
      gap: 20px;
      padding: 32px 16px;
    }
    .tabletop > * {
      flex: 1 1 0;
      width: auto;
    }
    .tabletop .stack {
      gap: 20px;
    }
    .seats {
      gap: 20px;
      padding: 0 16px;
    }
    .chair {
      width: 128px;
      height: 128px;
    }
    .contribution-heading {
      font-size: 18px;
      line-height: 1.6;
    }
    .contribution-list {
      font-size: 12px;
      line-height: 1.8;
    }
    .contribution-heading br,
    .same-side br {
      display: inline;
    }
    .same-side {
      font-size: 24px;
    }
    .statement,
    .heading-lg,
    .heading-md,
    .contact-heading {
      font-size: 34px;
      line-height: 48px;
    }
    .statement br,
    .heading-lg br,
    .heading-md br,
    .contact-heading br,
    .work-heading br,
    .echo br {
      display: inline;
    }
    .echo {
      font-size: 24px;
      line-height: 28px;
    }
    .photo {
      height: 320px;
    }
    .panis {
      font-size: 70px;
      line-height: 74px;
    }
    .origin-heading {
      font-size: 24px;
    }
    .capabilities li {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
      padding: 24px 0;
    }
    .capability {
      font-size: 24px;
    }
    .capability-description {
      flex: none;
    }
    .work-heading {
      font-size: 34px;
      line-height: 49px;
    }
    .notebook {
      display: none;
    }
    .process {
      grid-template-columns: 1fr;
      padding: 0;
      border-bottom: 0;
    }
    .process li {
      padding: 28px 20px;
      border-bottom: 1px solid var(--line);
    }
    .process li + li {
      border-left: 0;
    }
    .verb {
      font-size: 34px;
    }
    .talk {
      gap: 44px;
      font-size: 24px;
    }
    .site-footer {
      gap: 32px;
      padding: 32px 12px;
    }
    .footer-wordmark {
      font-size: 34px;
    }
  }
</style>
